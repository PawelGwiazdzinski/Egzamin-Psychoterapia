# Skopiuj do pliku .env i odkomentuj, czego potrzebujesz.

# Port aplikacji
# PORT=8765

# Unlimited-OCR 2 (baidu/Unlimited-OCR) – adres serwera SGLang (patrz README, sekcja OCR)
# UOCR_URL=http://127.0.0.1:10000

# ElevenLabs (opcjonalnie, własny klucz – darmowy limit ~10 tys. znaków/mies.)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_PL=
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_MODEL=eleven_multilingual_v2
